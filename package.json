{
  "name": "honoforge",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.1",
  "description": "Forge type-safe APIs at the speed of flame.",
  "author": "timDeHof",
  "license": "MIT",
  "homepage": "https://github.com/timDeHof/honoforge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timDeHof/honoforge.git"
  },
  "bugs": "https://github.com/timDeHof/honoforge/issues",
  "keywords": [
    "hono",
    "typescript",
    "status codes",
    "@hono/zod-openapi"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "lint": "pnpm -r lint",
    "prepublishOnly": "pnpm -r build",
    "release": "bumpp",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "prepare": "simple-git-hooks",
    "update-http-statuses": "esno scripts/update-http-statuses.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^25.6.2",
    "bumpp": "^11.1.0",
    "eslint": "^10.3.0",
    "eslint-plugin-format": "^2.0.1",
    "esno": "^4.8.0",
    "lint-staged": "^17.0.4",
    "publint": "^0.3.20",
    "simple-git-hooks": "^2.13.1",
    "ts-morph": "^28.0.0",
    "tsdown": "^0.22.0",
    "tsdown-stale-guard": "^0.1.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm run build && npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
