{
  "name": "@honoforge/openapi",
  "type": "module",
  "version": "0.1.0",
  "author": "timDeHof",
  "license": "MIT",
  "homepage": "https://github.com/timDeHof/honoforge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timDeHof/honoforge.git",
    "directory": "packages/openapi"
  },
  "bugs": "https://github.com/timDeHof/honoforge/issues",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "eslint"
  },
  "peerDependencies": {
    "@hono/zod-openapi": ">=1.4.0",
    "hono": ">=4.10.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@hono/zod-openapi": {
      "optional": false
    },
    "hono": {
      "optional": false
    },
    "zod": {
      "optional": false
    }
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@honoforge/core": "workspace:^",
    "hono": "^4.12.18",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "zod": "^3.25.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  }
}
