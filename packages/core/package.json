{
  "name": "@honoforge/core",
  "type": "module",
  "version": "0.1.0",
  "author": "timDeHof",
  "license": "MIT",
  "homepage": "https://github.com/timDeHof/honoforge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timDeHof/honoforge.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/timDeHof/honoforge/issues",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "eslint"
  },
  "peerDependencies": {
    "hono": ">=4.10.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": false
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  }
}
